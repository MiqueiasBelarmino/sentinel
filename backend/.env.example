PORT=3333
SENTINEL_PASSWORD=troque_para_uma_senha_forte
SESSION_SECRET=gere_uma_string_aleatoria_longa_aqui
NODE_ENV=production

# Caminho absoluto para a raiz do projeto Entrega Certa na VPS
# Exemplo Linux: /var/www/entrega-certa/api
# Exemplo Windows: C:\Projetos\entrega-certa\api
ENTREGA_CERTA_API_DIR=/var/www/entrega-certa/api

# URL interna de health check da API do Entrega Certa
ENTREGA_CERTA_HEALTH_URL=http://localhost:3003/health
